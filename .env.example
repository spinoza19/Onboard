# ─── Frontend (optional — sensible defaults are compiled in) ───────────────────
VITE_WALLET_URL=https://sphere.unicity.network
VITE_WELCOME_BOT=@welcome
# Leave unset on Vercel: the api/ functions are served from the same origin.
# VITE_API_BASE=/api

# ─── Serverless issuer (api/) — set these in the Vercel project ────────────────
# REQUIRED. The issuer's identity. Generate once, then never change it or the
# issuer pubkey (and therefore every badge's provenance) changes too.
MNEMONIC=

# REQUIRED. Injected automatically by the Vercel Upstash integration as KV_*;
# set the UPSTASH_* pair by hand if you provisioned Redis yourself.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional overrides.
BOT_NAMETAG=welcome
WALLET_API_URL=https://wallet-api.unicity.network
GATEWAY_API_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590
DEVICE_ID=onboard-issuer
