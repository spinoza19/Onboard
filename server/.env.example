# Port the issuer listens on. The Vite dev server proxies /api here.
PORT=8788

# Where the issuer wallet (keys + payment journals) is stored.
DATA_DIR=./wallet-data
LEDGER_PATH=./wallet-data/badges.json

# Leave MNEMONIC empty on the very first run: a wallet is generated and the
# mnemonic is printed once. Paste it back here to keep the same identity.
MNEMONIC=

# The nametag the welcome bot answers on. Registered on first boot.
BOT_NAMETAG=welcome

# testnet2 rails. The gateway key below is public and documented as such.
WALLET_API_URL=https://wallet-api.unicity.network
GATEWAY_API_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590
DEVICE_ID=onboard-issuer

# Badge coin id (lowercase 64-hex) and how much the bot sends back (base units).
BADGE_COIN_ID=0b0a4d0e0b0a4d0e0b0a4d0e0b0a4d0e0b0a4d0e0b0a4d0e0b0a4d0e0b0a4d0e
REPLY_AMOUNT=1000000
